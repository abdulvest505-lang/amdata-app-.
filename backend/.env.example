# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# Database (PostgreSQL connection string, e.g. from Render/Railway/Neon)
DATABASE_URL=postgres://user:password@host:5432/amdata

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_SIGNUP_CODE=change_this_secret_admin_code

# Paystack (get from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# VTpass (get from https://vtpass.com/ -> API section, sandbox first)
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_EMAIL=your_vtpass_email@example.com
VTPASS_PASSWORD=your_vtpass_password
VTPASS_PUBLIC_KEY=PK_xxxxxxxxxxxxxxxxxxxx
VTPASS_SECRET_KEY=SK_xxxxxxxxxxxxxxxxxxxx
